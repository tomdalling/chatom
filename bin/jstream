#!/usr/bin/env ruby

require 'json'

STDOUT.sync = true

def truncate(str, max)
  str = str.gsub(/\s+/, ' ').strip
  str.length > max ? "#{str[0...max]}…" : str
end

def format_tool_input(input)
  return '' unless input.is_a?(Hash)
  parts = input.map do |k, v|
    val = v.to_s.gsub(/\s+/, ' ').strip
    val = val[0..60] + '…' if val.length > 60
    "#{k}=#{val}"
  end
  parts.join(' ')
end

def extract_text(content)
  case content
  when String then content
  when Array  then content.map { |c| c['text'] }.compact.join(' ')
  else content.to_s
  end
end

STDIN.each_line do |line|
  line.strip!
  next if line.empty?

  begin
    obj = JSON.parse(line)
  rescue JSON::ParserError
    puts "[invalid] #{line[0..100]}"
    next
  end

  case obj['type']
  when 'system'
    next unless obj['subtype'] == 'init'
    puts "[init] model=#{obj['model']} tools=#{obj['tools']&.size || 0} cwd=#{obj['cwd']}"

  when 'assistant'
    (obj.dig('message', 'content') || []).each do |block|
      case block['type']
      when 'text'
        text = truncate(block['text'], 200)
        puts "[text] #{text}" unless text.empty?
      when 'thinking'
        puts "[think] #{truncate(block['thinking'], 100)}"
      when 'tool_use'
        args = format_tool_input(block['input'])
        puts "[call:#{block['name']}] #{args}"
      end
    end

  when 'user'
    (obj.dig('message', 'content') || []).each do |block|
      next unless block['type'] == 'tool_result'
      text = truncate(extract_text(block['content']), 200)
      tag = block['is_error'] ? '[error]' : '[result]'
      puts "#{tag} #{text}"
    end

  when 'result'
    cost     = obj['total_cost_usd']
    duration = obj['duration_ms']
    turns    = obj['num_turns']
    status   = obj['is_error'] ? 'error' : obj['subtype'] || 'done'
    cost_str = cost ? format('$%.5f', cost) : 'n/a'
    dur_str  = duration ? "#{(duration / 1000.0).round(2)}s" : 'n/a'
    puts "[#{status}] turns=#{turns} cost=#{cost_str} time=#{dur_str}"

  when 'rate_limit_event'
    info = obj['rate_limit_info']
    next if info.nil? || info['status'] == 'allowed'
    puts "[rate_limit] #{info['status']} type=#{info['rateLimitType']}"
  end
end
